{
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "PaperTrail: 调试 code001",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/agent/paper_trail/simple/code001.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/agent:${env:PYTHONPATH}"
            },
            "envFile": "${workspaceFolder}/configs/paper_trail/.env",
            "justMyCode": false
        },
        {
            "name": "PaperTrail: 附加调试 code001",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": false
        }
    ],
    "version": "0.2.0"
}

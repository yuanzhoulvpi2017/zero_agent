{
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "PaperTrail: 调试 code001",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/agent/paper_trail/simple/code001.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/agent:${env:PYTHONPATH}",
                "NO_PROXY": "api.deepseek.com,huggingface.co,hf.co,${env:NO_PROXY}",
                "no_proxy": "api.deepseek.com,huggingface.co,hf.co,${env:no_proxy}"
            },
            "envFile": "${workspaceFolder}/configs/paper_trail/.env",
            "justMyCode": false
        },
        {
            "name": "PaperTrail: 调试 code001_fakeuser",
            "type": "debugpy",
            "request": "launch",
            "python": "${workspaceFolder}/.venv/bin/python",
            "program": "${workspaceFolder}/agent/paper_trail/simple/code001_fakeuser.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/agent:${env:PYTHONPATH}",
                // "NO_PROXY": "api.deepseek.com,huggingface.co,hf.co,${env:NO_PROXY}",
                // "no_proxy": "api.deepseek.com,huggingface.co,hf.co,${env:no_proxy}"
            },
            "envFile": "${workspaceFolder}/configs/paper_trail/.env",
            "justMyCode": false,
            "args": [
                "--turns",
                "3",
                "--seed",
                "42"
            ]
        },
        {
            "name": "PaperTrail: 附加调试 code001",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": false
        }
    ],
    "version": "0.2.0"
}
